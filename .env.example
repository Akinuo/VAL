# Public values only. Copy to .env.local and fill in from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Canonical site URL used for generated QR codes/links (no trailing slash).
# Without this, QR codes use whatever domain the page happens to be loaded
# from (e.g. the *.vercel.app preview URL) instead of your real domain.
NEXT_PUBLIC_SITE_URL=https://val-akinuo.vercel.app

# Feedback emailing (server-side only — never prefix with NEXT_PUBLIC_).
# Optional: without these, feedback still saves to Supabase if configured above,
# it just won't be emailed. Use a Gmail address + an App Password (Google
# Account > Security > 2-Step Verification > App passwords) — not the account's
# normal login password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# Optional — where feedback PDFs are sent. Defaults to bingmenoso@gmail.com.
FEEDBACK_TO_EMAIL=bingmenoso@gmail.com